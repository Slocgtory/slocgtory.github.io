---
import { inline } from '../lib/i18n';
import { POLICY_UPDATED } from '../../site.config.mjs';

interface Section {
  id: string;
  h: string;
  p: string[];
  list?: string[];
}

interface Props {
  privacy: {
    title: string;
    updated: string;
    canonicalNote: string;
    summary: string;
    sections: Section[];
  };
  isCanonical: boolean;
  /** An app policy carries its own date; the site-wide one uses POLICY_UPDATED. */
  updatedIso?: string;
}

const { privacy, isCanonical, updatedIso } = Astro.props;
---

<div class="doc-head">
  <h1>{privacy.title}</h1>
  <p class="updated"><time datetime={updatedIso ?? POLICY_UPDATED}>{privacy.updated}</time></p>
</div>

{
  !isCanonical && privacy.canonicalNote && (
    <p class="canon-note" set:html={inline(privacy.canonicalNote)} />
  )
}

<p class="summary" set:html={inline(privacy.summary)} />

{
  privacy.sections.map((section) => (
    <section class="doc-section">
      {/*
        The heading carries the anchor and the link points at itself, so a
        clause can be sent to somebody.

        `aria-labelledby` on the link resolves to the heading's own text, which
        means the link announces as the section it goes to - in whatever
        language the page is in - without a sixteenth translation of the words
        "link to this section". The visible mark is hidden from the accessible
        name so it does not read as "hash".
      */}
      <h2 id={section.id}>
        {section.h}
        <a class="anchor" href={`#${section.id}`} aria-labelledby={section.id}>
          <span aria-hidden="true">#</span>
        </a>
      </h2>
      <div class="body">
        {section.p.map((paragraph) => (
          <p set:html={inline(paragraph)} />
        ))}
        {section.list && (
          <ul>
            {section.list.map((item) => (
              <li set:html={inline(item)} />
            ))}
          </ul>
        )}
      </div>
    </section>
  ))
}
