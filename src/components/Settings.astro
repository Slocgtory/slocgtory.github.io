---
import { getCollection } from 'astro:content';
import { localeUrl, localesInReadingOrder, type Page } from '../lib/i18n';

interface Props {
  locale: string;
  page: Page;
  langLabel: string;
  theme: { label: string; system: string; light: string; dark: string };
}

const { locale, page, langLabel, theme } = Astro.props;

const entries = await getCollection('i18n');
const names = new Map(entries.map((e) => [e.id, e.data.name]));
const endonym = (code: string) => names.get(code) ?? code;

const ordered = localesInReadingOrder(locale, endonym);
---

<div class="settings">
  {/*
    Hidden until the script below unhides it. Without JavaScript the choice
    cannot outlive the page, so an always-visible control would be one that
    forgets - worse than not offering it. The system's own setting still works,
    because the stylesheet answers `prefers-color-scheme` on its own.

    Real radios with one name, so the browser gives arrow-key movement, the
    roving tab stop and the announcement free. A row of buttons with ARIA would
    have to reimplement all three, and usually reimplements two.

    Every icon carries its word as well, out of sight. A sun and a moon are a
    well-worn pair, but a screen reader has no idea what a path element means,
    and `title` alone is not an accessible name.
  */}
  <div class="seg" role="radiogroup" aria-label={theme.label} hidden data-theme-control>
    <label title={theme.system}>
      <input type="radio" name="theme" value="system" checked />
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <rect x="2.5" y="3.5" width="19" height="13" rx="2"></rect>
          <path d="M8.5 20.5h7M12 17v3.5"></path>
        </svg>
      </span>
      <span class="sr-only">{theme.system}</span>
    </label>

    <label title={theme.light}>
      <input type="radio" name="theme" value="light" />
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M6 18l-1.4 1.4M19.4 4.6L18 6"
          ></path>
        </svg>
      </span>
      <span class="sr-only">{theme.light}</span>
    </label>

    <label title={theme.dark}>
      <input type="radio" name="theme" value="dark" />
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <path d="M20.5 13.3A8.5 8.5 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8z"></path>
        </svg>
      </span>
      <span class="sr-only">{theme.dark}</span>
    </label>
  </div>

  {/*
    Plain links inside a disclosure, so this one needs no script at all: every
    entry is a real address for the same page in another language, and it works
    with scripting off, in a text browser, and when a link is copied.
  */}
  <details class="picker" data-lang-picker>
    <summary aria-label={langLabel}>
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"></path>
        </svg>
      </span>
      <span class="picker-current" lang={locale}>{endonym(locale)}</span>
    </summary>
    <nav aria-label={langLabel}>
      <ul>
        {
          ordered.map((code) => (
            <li>
              <a
                href={localeUrl(page, code)}
                hreflang={code}
                lang={code}
                aria-current={code === locale ? 'true' : undefined}
              >
                {endonym(code)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
</div>

{/*
  Deliberately inline and un-bundled. It is short enough to read in one go, and
  it is the only script on the site: nothing is fetched to run it.
*/}
<script is:inline>
  (function () {
    var root = document.documentElement;
    var control = document.querySelector('[data-theme-control]');
    if (!control) return;

    // Only now, when there is something to work the control with.
    control.hidden = false;

    function saved() {
      try {
        var value = localStorage.getItem('theme');
        return value === 'light' || value === 'dark' ? value : 'system';
      } catch (e) {
        // Private windows and blocked site data throw on read. A visitor who
        // cannot be remembered still gets the system's own setting.
        return 'system';
      }
    }

    function apply(choice) {
      // Removing the attribute is what "system" means: with nothing stamped,
      // the stylesheet falls through to prefers-color-scheme.
      if (choice === 'system') delete root.dataset.theme;
      else root.dataset.theme = choice;

      var picked = control.querySelector('input[value="' + choice + '"]');
      if (picked) picked.checked = true;
    }

    control.addEventListener('change', function (event) {
      var input = event.target;
      if (!input || input.name !== 'theme') return;
      try {
        if (input.value === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', input.value);
      } catch (e) {
        // Nothing to do: the choice still applies to this page.
      }
      apply(input.value);
    });

    apply(saved());
  })();

  (function () {
    // Closing the language list by clicking away or pressing Escape - what a
    // menu is expected to do. Everything it decorates already works without it.
    var picker = document.querySelector('[data-lang-picker]');
    if (!picker) return;

    document.addEventListener('click', function (event) {
      if (picker.open && !picker.contains(event.target)) picker.open = false;
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && picker.open) {
        picker.open = false;
        var summary = picker.querySelector('summary');
        if (summary) summary.focus();
      }
    });
  })();
</script>
