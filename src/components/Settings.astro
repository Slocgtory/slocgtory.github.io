---
import { getCollection } from 'astro:content';
import { localeUrl, localesInReadingOrder, type Page } from '../lib/i18n';

interface Props {
  locale: string;
  page: Page;
  settingsLabel: string;
  langLabel: string;
  theme: { label: string; system: string; light: string; dark: string };
}

const { locale, page, settingsLabel, langLabel, theme } = Astro.props;

const entries = await getCollection('i18n');
const names = new Map(entries.map((e) => [e.id, e.data.name]));
const endonym = (code: string) => names.get(code) ?? code;

const ordered = localesInReadingOrder(locale, endonym);
---

{/*
  One control rather than two.

  Three separate things used to sit here - two nav links, an appearance switch
  and a language switch - and none of them agreed on a height, a padding or a
  shape. The appearance one was an icon in a box the width of an icon; the
  language one was an icon plus a word in a box twice as wide; the nav links
  were bare text with no box at all. Three sizes in twenty centimetres of bar.

  Both of these are settings, which is a different kind of thing from a link to
  a page, so they belong behind one button rather than beside the navigation.
  What is left in the bar is the name, the one other page, and this.
*/}
<details class="settings" data-settings>
  <summary aria-label={settingsLabel} title={settingsLabel}>
    <span class="ico" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="19" height="19">
        <path d="M3 8h11M18.5 8H21M3 16h5.5M13 16h8"></path>
        <circle cx="16" cy="8" r="2.5"></circle>
        <circle cx="10.5" cy="16" r="2.5"></circle>
      </svg>
    </span>
  </summary>

  <div class="panel">
    {/*
      Only this half needs a script, and only this half is hidden without one:
      the choice cannot outlive the page, and a control that forgets is worse
      than one not offered. The stylesheet still answers the system setting.
    */}
    <section class="group" hidden data-theme-control>
      <h2>{theme.label}</h2>
      {/*
        Real radios with one name, so arrow keys, the roving tab stop and the
        announcement come from the browser. Buttons with ARIA would have to
        reimplement all three, and usually reimplement two.
      */}
      <ul class="choices" role="radiogroup" aria-label={theme.label}>
        <li>
          <label>
            <input type="radio" name="theme" value="system" checked />
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <rect x="2.5" y="3.5" width="19" height="13" rx="2"></rect>
                <path d="M8.5 20.5h7M12 17v3.5"></path>
              </svg>
            </span>
            <span>{theme.system}</span>
          </label>
        </li>
        <li>
          <label>
            <input type="radio" name="theme" value="light" />
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M6 18l-1.4 1.4M19.4 4.6L18 6"
                ></path>
              </svg>
            </span>
            <span>{theme.light}</span>
          </label>
        </li>
        <li>
          <label>
            <input type="radio" name="theme" value="dark" />
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <path d="M20.5 13.3A8.5 8.5 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8z"></path>
              </svg>
            </span>
            <span>{theme.dark}</span>
          </label>
        </li>
      </ul>
    </section>

    {/*
      Plain links, so this half needs no script at all: every entry is a real
      address for the same page in another language, and it works with scripting
      off, in a text browser, and when a link is copied.
    */}
    <section class="group">
      <h2>{langLabel}</h2>
      <ul class="languages">
        {
          ordered.map((code) => (
            <li>
              <a
                href={localeUrl(page, code)}
                hreflang={code}
                lang={code}
                aria-current={code === locale ? 'true' : undefined}
              >
                {endonym(code)}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</details>

{/*
  Deliberately inline and un-bundled. Short enough to read in one go, and the
  only script on the site: nothing is fetched to run it.
*/}
<script is:inline>
  (function () {
    var root = document.documentElement;
    var group = document.querySelector('[data-theme-control]');
    if (!group) return;

    // Only now, when there is something to work the control with.
    group.hidden = false;

    function saved() {
      try {
        var value = localStorage.getItem('theme');
        return value === 'light' || value === 'dark' ? value : 'system';
      } catch (e) {
        // Private windows and blocked site data throw on read. A visitor who
        // cannot be remembered still gets the system's own setting.
        return 'system';
      }
    }

    function apply(choice) {
      // Removing the attribute is what "system" means: with nothing stamped,
      // the stylesheet falls through to prefers-color-scheme.
      if (choice === 'system') delete root.dataset.theme;
      else root.dataset.theme = choice;

      var input = group.querySelector('input[value="' + choice + '"]');
      if (input) input.checked = true;

      var dark =
        choice === 'dark' ||
        (choice === 'system' &&
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
      var meta = document.querySelector('[data-theme-color]');
      if (meta) meta.setAttribute('content', dark ? '#0C0D10' : '#FBFBFC');
    }

    group.addEventListener('change', function (event) {
      var input = event.target;
      if (!input || input.name !== 'theme') return;
      try {
        if (input.value === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', input.value);
      } catch (e) {
        // Nothing to do: the choice still applies to this page.
      }
      apply(input.value);
    });

    apply(saved());
  })();

  (function () {
    // What a menu is expected to do: close on a click away or on Escape.
    // Everything underneath already works without any of it.
    var menu = document.querySelector('[data-settings]');
    if (!menu) return;

    document.addEventListener('click', function (event) {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      var summary = menu.querySelector('summary');
      if (summary) summary.focus();
    });
  })();
</script>
