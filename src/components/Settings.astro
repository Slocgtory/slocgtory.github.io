---
import { getCollection } from 'astro:content';
import { localeUrl, localesInReadingOrder, type Page } from '../lib/i18n';

interface Props {
  locale: string;
  page: Page;
  langLabel: string;
  theme: { label: string; system: string; light: string; dark: string };
}

const { locale, page, langLabel, theme } = Astro.props;

const entries = await getCollection('i18n');
const names = new Map(entries.map((e) => [e.id, e.data.name]));
const endonym = (code: string) => names.get(code) ?? code;

const ordered = localesInReadingOrder(locale, endonym);

const choices = [
  { value: 'system', label: theme.system },
  { value: 'light', label: theme.light },
  { value: 'dark', label: theme.dark },
] as const;
---

<div class="settings">
  {/*
    A disclosure rather than three icons side by side, for two reasons. The
    control beside it is already one, and a header with two matching pills reads
    as a pair where a segment plus a pill reads as two unrelated things. And a
    theme is set once and then left alone - permanent visibility is worth paying
    header room for when a control is used often, which this is not.

    Hidden until the script unhides it: without JavaScript the choice cannot
    outlive the page, and a control that forgets is worse than one not offered.
    The system's own setting still works, because the stylesheet answers
    prefers-color-scheme on its own.
  */}
  <details class="picker theme-picker" data-choice="system" hidden data-theme-control>
    <summary aria-label={theme.label}>
      {/*
        All three icons are rendered and CSS shows the one matching
        `data-choice`. The alternative is JavaScript that carries SVG path data
        in a string, where the markup and the script would each hold half of
        what the icon is.
      */}
      <span class="ico" data-for="system" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <rect x="2.5" y="3.5" width="19" height="13" rx="2"></rect>
          <path d="M8.5 20.5h7M12 17v3.5"></path>
        </svg>
      </span>
      <span class="ico" data-for="light" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M6 18l-1.4 1.4M19.4 4.6L18 6"
          ></path>
        </svg>
      </span>
      <span class="ico" data-for="dark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <path d="M20.5 13.3A8.5 8.5 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8z"></path>
        </svg>
      </span>
    </summary>

    {/*
      Real radios with one name, so arrow keys, the roving tab stop and the
      announcement come from the browser. A list of buttons with ARIA would have
      to reimplement all three, and usually reimplements two.
    */}
    <nav>
      <ul role="radiogroup" aria-label={theme.label}>
        {
          choices.map(({ value, label }) => (
            <li>
              <label>
                <input type="radio" name="theme" value={value} checked={value === 'system'} />
                <span class="ico" data-for={value} aria-hidden="true">
                  {value === 'system' && (
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <rect x="2.5" y="3.5" width="19" height="13" rx="2" />
                      <path d="M8.5 20.5h7M12 17v3.5" />
                    </svg>
                  )}
                  {value === 'light' && (
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <circle cx="12" cy="12" r="4" />
                      <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M6 18l-1.4 1.4M19.4 4.6L18 6" />
                    </svg>
                  )}
                  {value === 'dark' && (
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <path d="M20.5 13.3A8.5 8.5 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8z" />
                    </svg>
                  )}
                </span>
                <span>{label}</span>
              </label>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>

  {/*
    Plain links inside a disclosure, so this one needs no script at all: every
    entry is a real address for the same page in another language, and it works
    with scripting off, in a text browser, and when a link is copied.
  */}
  <details class="picker lang-picker" data-lang-picker>
    <summary aria-label={langLabel}>
      <span class="ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"></path>
        </svg>
      </span>
      <span class="picker-current" lang={locale}>{endonym(locale)}</span>
    </summary>
    <nav>
      <ul aria-label={langLabel}>
        {
          ordered.map((code) => (
            <li>
              <a
                href={localeUrl(page, code)}
                hreflang={code}
                lang={code}
                aria-current={code === locale ? 'true' : undefined}
              >
                {endonym(code)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
</div>

{/*
  Deliberately inline and un-bundled. Short enough to read in one go, and the
  only script on the site: nothing is fetched to run it.
*/}
<script is:inline>
  (function () {
    var root = document.documentElement;
    var picker = document.querySelector('[data-theme-control]');
    if (!picker) return;

    // Only now, when there is something to work the control with.
    picker.hidden = false;

    function saved() {
      try {
        var value = localStorage.getItem('theme');
        return value === 'light' || value === 'dark' ? value : 'system';
      } catch (e) {
        // Private windows and blocked site data throw on read. A visitor who
        // cannot be remembered still gets the system's own setting.
        return 'system';
      }
    }

    function apply(choice) {
      // Removing the attribute is what "system" means: with nothing stamped,
      // the stylesheet falls through to prefers-color-scheme.
      if (choice === 'system') delete root.dataset.theme;
      else root.dataset.theme = choice;

      // One attribute; the stylesheet decides which icon the summary shows.
      picker.dataset.choice = choice;

      var input = picker.querySelector('input[value="' + choice + '"]');
      if (input) input.checked = true;
    }

    picker.addEventListener('change', function (event) {
      var input = event.target;
      if (!input || input.name !== 'theme') return;
      try {
        if (input.value === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', input.value);
      } catch (e) {
        // Nothing to do: the choice still applies to this page.
      }
      apply(input.value);
      picker.open = false;
    });

    apply(saved());
  })();

  (function () {
    // What a menu is expected to do: only one open, close on a click away or on
    // Escape. Everything underneath already works without any of it.
    var pickers = document.querySelectorAll('details.picker');
    if (!pickers.length) return;

    pickers.forEach(function (picker) {
      picker.addEventListener('toggle', function () {
        if (!picker.open) return;
        pickers.forEach(function (other) {
          if (other !== picker) other.open = false;
        });
      });
    });

    document.addEventListener('click', function (event) {
      pickers.forEach(function (picker) {
        if (picker.open && !picker.contains(event.target)) picker.open = false;
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      pickers.forEach(function (picker) {
        if (!picker.open) return;
        picker.open = false;
        var summary = picker.querySelector('summary');
        if (summary) summary.focus();
      });
    });
  })();
</script>
