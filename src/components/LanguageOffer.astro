---
import { getCollection } from 'astro:content';
import { localeUrl, LOCALES, type Page } from '../lib/i18n';

interface Props {
  locale: string;
  page: Page;
}

const { locale, page } = Astro.props;

const entries = await getCollection('i18n');
const byCode = new Map(entries.map((e) => [e.id, e.data]));

/** Every language but the one being read, each offering itself in its own words. */
const others = LOCALES.filter((code) => code !== locale).map((code) => ({
  code,
  url: localeUrl(page, code),
  offer: byCode.get(code)?.site.otherLanguage ?? '',
  dismiss: byCode.get(code)?.site.dismiss ?? '',
}));
---

{/*
  An offer, not a redirect.

  Google's guidance on multilingual sites is explicit: do not send a visitor to
  another language because you think it is theirs. It stops them - and the
  crawler, which does not send Accept-Language at all - from reaching the other
  versions. Add links and let people choose.

  So nothing moves on its own. If the browser asks for a language this site
  speaks, and the page being read is not in it, one line appears offering it.
  Written in that language, because a line in English offering Polish is no use
  to somebody who is here because they do not read English.

  All sixteen are rendered and hidden, and the script unhides at most one. The
  alternative is building the sentence in JavaScript, which would put half of
  each translation in a script and half in the table.
*/}
<div class="lang-offer" hidden data-lang-offer>
  {
    others.map(({ code, url, offer, dismiss }) => (
      <p class="offer" lang={code} hidden data-offer-for={code}>
        <a href={url} hreflang={code}>
          {offer}
        </a>
        <button type="button" data-offer-dismiss aria-label={dismiss} title={dismiss}>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </span>
        </button>
      </p>
    ))
  }
</div>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-lang-offer]');
    if (!box) return;

    var here = document.documentElement.lang;

    // Worked out in the head, before anything rendered. See there for why it
    // is one place rather than two.
    var match = document.documentElement.getAttribute('data-browser-locale');
    if (!match || match === here) return;

    // Turned down once is turned down. Per language, so a later visit in a
    // different browser language still gets asked.
    var key = 'lang-offer-declined:' + match;
    try {
      if (localStorage.getItem(key) === '1') return;
    } catch (e) {
      // Blocked site data: show it, and it simply will not be remembered.
    }

    var line = box.querySelector('[data-offer-for="' + match + '"]');
    if (!line) return;
    line.hidden = false;
    box.hidden = false;

    line.querySelector('[data-offer-dismiss]').addEventListener('click', function () {
      box.hidden = true;
      try {
        localStorage.setItem(key, '1');
      } catch (e) {
        // Nothing to do.
      }
    });
  })();
</script>
