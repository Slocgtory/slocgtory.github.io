---
import { Font } from 'astro:assets';
import Settings from '../components/Settings.astro';
import { SITE_URL } from '../../site.config.mjs';
import { alternatesFor, localeUrl, DEFAULT_LOCALE, type Page } from '../lib/i18n';
import '../styles/global.css';

interface Site {
  skip: string;
  navLabel: string;
  langLabel: string;
  email: string;
  nav: { privacy: string };
  settingsLabel: string;
  theme: { label: string; system: string; light: string; dark: string };
}

interface Props {
  locale: string;
  page: Page;
  title: string;
  description: string;
  site: Site;
}

const { locale, page, title, description, site } = Astro.props;

const alternates = alternatesFor(page);
const canonical = new URL(localeUrl(page, locale), SITE_URL).href;
const homeHref = localeUrl('home', locale);
const privacyHref = localeUrl('privacy', locale);
const year = 2026;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      First thing in the document, before a single byte of the stylesheet, and
      deliberately not deferred. A saved theme has to be stamped on <html>
      before the first paint or the page shows in the system's colours and then
      snaps to the chosen ones - a flash that looks like a fault and is worst
      for exactly the person who chose dark because light hurts.
    */}
    <script is:inline>
      (function () {
        var choice = 'system';
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') choice = t;
        } catch (e) {
          // Blocked site data. The stylesheet still answers the system setting.
        }
        if (choice !== 'system') document.documentElement.dataset.theme = choice;

        var dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        var meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', dark ? '#0C0D10' : '#FBFBFC');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      alternates.map(({ code, url }) => (
        <link rel="alternate" hreflang={code} href={new URL(url, SITE_URL).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeUrl(page, DEFAULT_LOCALE), SITE_URL).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Slocgtory" />
    <meta property="og:site_name" content="Slocgtory" />

    {/*
      The browser chrome on a phone. Set here as light and corrected by the
      script above before paint, because a saved theme is not a media query and
      `media=` on this tag cannot see it.
    */}
    <meta name="theme-color" content="#FBFBFC" data-theme-color />

    <link rel="icon" href="/icon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      One file each, not eighteen. `preload` with no argument preloads every
      weight, style and subset a face has - measured, that was 18 <link
      rel=preload> on the home page, all of them competing for the same early
      bandwidth that the HTML and the stylesheet need. Preloading everything is
      preloading nothing.

      So: the body regular and the display weight the headings use, both Latin.
      Latin Extended still loads when a page needs it, just not ahead of the
      page itself, and the mono face is small and below the fold.
    */}
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font
      cssVariable="--font-display"
      preload={[{ weight: 600, style: 'normal', subset: 'latin' }]}
    />
    <Font cssVariable="--font-mono" />
  </head>

  <body>
    <a class="skip" href="#main">{site.skip}</a>

    <header class="site-head">
      <div class="inner">
        {/*
          The wordmark is the link home, which is what a wordmark in a header is
          for - so a separate "Home" beside it was the same destination twice.
          What is left is the name, the one other page, and settings.
        */}
        <a class="wordmark" href={homeHref}>Slocgtory</a>

        <nav class="site-nav" aria-label={site.navLabel}>
          <a
            class="nav-link"
            href={privacyHref}
            aria-current={page === 'privacy' ? 'page' : undefined}
          >
            {site.nav.privacy}
          </a>
        </nav>

        <Settings
          locale={locale}
          page={page}
          settingsLabel={site.settingsLabel}
          langLabel={site.langLabel}
          theme={site.theme}
        />
      </div>
    </header>

    {/*
      No footer. It held a copyright line and the contact address, and the
      address is already where somebody looks for it - in Contact on the home
      page, and under Contact in the policy, which is the one Meta's submission
      form points at. A strip repeating it under every page was furniture.
    */}
    <main id="main">
      <slot />
    </main>
  </body>
</html>
