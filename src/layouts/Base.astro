---
import { Font } from 'astro:assets';
import Settings from '../components/Settings.astro';
import { SITE_URL } from '../../site.config.mjs';
import { alternatesFor, localeUrl, DEFAULT_LOCALE, type Page } from '../lib/i18n';
import '../styles/global.css';

interface Site {
  skip: string;
  navLabel: string;
  langLabel: string;
  email: string;
  nav: { home: string; privacy: string };
  theme: { label: string; system: string; light: string; dark: string };
}

interface Props {
  locale: string;
  page: Page;
  title: string;
  description: string;
  site: Site;
}

const { locale, page, title, description, site } = Astro.props;

const alternates = alternatesFor(page);
const canonical = new URL(localeUrl(page, locale), SITE_URL).href;
const homeHref = localeUrl('home', locale);
const privacyHref = localeUrl('privacy', locale);
const year = 2026;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      First thing in the document, before a single byte of the stylesheet, and
      deliberately not deferred. A saved theme has to be stamped on <html>
      before the first paint or the page shows in the system's colours and then
      snaps to the chosen ones - a flash that looks like a fault and is worst
      for exactly the person who chose dark because light hurts.
    */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          // Blocked site data. The stylesheet still answers the system setting.
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      alternates.map(({ code, url }) => (
        <link rel="alternate" hreflang={code} href={new URL(url, SITE_URL).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeUrl(page, DEFAULT_LOCALE), SITE_URL).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />
  </head>

  <body>
    <a class="skip" href="#main">{site.skip}</a>

    <header class="site-head">
      <div class="inner">
        <a class="wordmark" href={homeHref}>Slocgtory</a>
        <nav class="site-nav" aria-label={site.navLabel}>
          <a href={homeHref} aria-current={page === 'home' ? 'page' : undefined}>{site.nav.home}</a>
          <a href={privacyHref} aria-current={page === 'privacy' ? 'page' : undefined}>
            {site.nav.privacy}
          </a>
        </nav>
        <Settings locale={locale} page={page} langLabel={site.langLabel} theme={site.theme} />
      </div>
    </header>

    {/*
      No footer. It held a copyright line and the contact address, and the
      address is already where somebody looks for it - in Contact on the home
      page, and under Contact in the policy, which is the one Meta's submission
      form points at. A strip repeating it under every page was furniture.
    */}
    <main id="main">
      <slot />
    </main>
  </body>
</html>
