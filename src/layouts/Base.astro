---
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import Settings from '../components/Settings.astro';
import LanguageOffer from '../components/LanguageOffer.astro';
import { SITE_URL, OG_LOCALES } from '../../site.config.mjs';
import { alternatesFor, localeUrl, DEFAULT_LOCALE, LOCALES, type Page } from '../lib/i18n';
import '../styles/global.css';

interface Site {
  skip: string;
  navLabel: string;
  langLabel: string;
  email: string;
  nav: { home: string; apps: string; privacy: string };
  settingsLabel: string;
  theme: { label: string; system: string; light: string; dark: string };
}

interface Props {
  locale: string;
  page: Page;
  title: string;
  description: string;
  site: Site;
  /** Only the catalogue passes these, and only so they can be described to a
   *  crawler. Everything shown on the page comes from the page's own body. */
  apps?: { name: string; status: string; desc: string }[];
  /** The 404, which is not a page in the site's own sense and must not describe
   *  itself as one. See where this is used below. */
  errorPage?: boolean;
}

const { locale, page, title, description, site, apps, errorPage = false } = Astro.props;

const alternates = alternatesFor(page);
const canonical = new URL(localeUrl(page, locale), SITE_URL).href;
const homeHref = localeUrl('home', locale);
const appsHref = localeUrl('apps', locale);
const privacyHref = localeUrl('privacy', locale);

/** The tab strip, in the order the site reads. */
const tabs = [
  { key: 'home', href: homeHref, label: site.nav.home },
  { key: 'apps', href: appsHref, label: site.nav.apps },
  { key: 'privacy', href: privacyHref, label: site.nav.privacy },
] as const;

/*
  What this site is, for a machine.

  Deliberately thin. There is no rating, no price and no release date, so none
  of that is here - a graph is a set of claims, and the temptation with schema
  is to answer questions nobody asked and get one of them wrong. No `logo`
  either: the icon is a placeholder letter mark, and pointing Google at it as
  the studio's logo would make a placeholder permanent.

  The organisation carries an `@id` so the catalogue's entries can point at it
  rather than restating it, and it is repeated on the pages that reference it
  because a crawler reads one page at a time.
*/
/*
  The social card for this language, and its alt text read from the same file
  the card was drawn from - so the two cannot drift. There was one card for all
  sixteen and nothing on it could have been translated, so a link to the Polish
  page shared as an English object.
*/
const card = new URL(`/og/${locale}.png`, SITE_URL).href;
const cardAlt = (await getEntry('i18n', locale))?.data.home.title ?? 'Slocgtory';

const ORG_ID = `${SITE_URL}/#slocgtory`;

const organisation = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Slocgtory',
  url: `${SITE_URL}/`,
  email: site.email,
};

const graph = [];
if (page === 'home') {
  graph.push(organisation, {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: `${SITE_URL}/`,
    name: 'Slocgtory',
    publisher: { '@id': ORG_ID },
    inLanguage: locale,
  });
} else if (page === 'apps' && apps?.length) {
  graph.push(
    organisation,
    ...apps.map((app) => ({
      '@type': 'VideoGame',
      name: app.name,
      description: app.desc,
      url: canonical,
      author: { '@id': ORG_ID },
      publisher: { '@id': ORG_ID },
      applicationCategory: 'GameApplication',
      gamePlatform: 'Meta Quest',
      operatingSystem: 'Meta Horizon OS',
      inLanguage: locale,
    })),
  );
}

/* `<` is escaped rather than left raw: inside a <script> a literal `</` ends
   the element, whatever the JSON meant by it. */
const jsonLd =
  graph.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\u003c')
    : null;
---

<!doctype html>
<!-- Every language here is left-to-right; see content.config.ts for why that
     is stated once here rather than carried per language. -->
<html lang={locale} dir="ltr" data-locales={LOCALES.join(' ')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      First thing in the document, before a single byte of the stylesheet, and
      deliberately not deferred. A saved theme has to be stamped on <html>
      before the first paint or the page shows in the system's colours and then
      snaps to the chosen ones - a flash that looks like a fault and is worst
      for exactly the person who chose dark because light hurts.
    */}
    <script is:inline>
      (function () {
        var choice = 'system';
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') choice = t;
        } catch (e) {
          // Blocked site data. The stylesheet still answers the system setting.
        }
        if (choice !== 'system') document.documentElement.dataset.theme = choice;

        var dark =
          choice === 'dark' ||
          (choice === 'system' &&
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        var meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', dark ? '#0C0D10' : '#FBFBFC');
      })();

      (function () {
        /*
          Which of this site's languages the browser is asking for.

          Worked out once, here, before anything renders, and written onto the
          document for whoever needs it. Two things do - the offer under the
          masthead and the System row in the settings panel - and they used to
          each have their own copy, which was both a second place to be wrong
          and an ordering trap: the panel's script runs first, so it read an
          answer the offer had not written yet and the row never appeared.

          Matching is on the primary subtag, so pl-PL finds pl. Chinese is the
          exception and matched on script instead: zh-TW, zh-HK and zh-MO want
          Traditional and the rest Simplified, and handing a reader the wrong
          one is a mistake rather than a near miss.
        */
        var root = document.documentElement;
        var have = (root.getAttribute('data-locales') || '').split(' ').filter(Boolean);
        if (!have.length) return;

        var asked = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < asked.length; i++) {
          var lower = String(asked[i]).toLowerCase();

          if (lower.indexOf('zh') === 0) {
            var traditional =
              lower.indexOf('hant') !== -1 ||
              lower.indexOf('tw') !== -1 ||
              lower.indexOf('hk') !== -1 ||
              lower.indexOf('mo') !== -1;
            var pick = traditional ? 'zh-Hant' : 'zh-Hans';
            if (have.indexOf(pick) !== -1) {
              root.setAttribute('data-browser-locale', pick);
              return;
            }
            continue;
          }

          var primary = lower.split('-')[0];
          for (var j = 0; j < have.length; j++) {
            if (have[j].toLowerCase().split('-')[0] === primary) {
              root.setAttribute('data-browser-locale', have[j]);
              return;
            }
          }
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /*
        An error page is not a page of this site, and everything below said it
        was. It is built through the same layout with `page="home"` - it has to
        be, because that is how it gets a header - and so it inherited the home
        page's canonical, the home page's og:url and sixteen hreflang links to
        the home page. It was telling every crawler that this error IS the home
        page. GitHub Pages does answer a real miss with a 404 status, which is
        the signal that counts, but /404.html itself answers 200 and was
        indexable while claiming to be the front door.

        So it identifies as nothing and asks not to be indexed.
      */
      errorPage ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    {
      !errorPage &&
      alternates.map(({ code, url }) => (
        <link rel="alternate" hreflang={code} href={new URL(url, SITE_URL).href} />
      ))
    }
    {
      !errorPage && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localeUrl(page, DEFAULT_LOCALE), SITE_URL).href}
        />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!errorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {
      /* The other fifteen, so a share card in one language knows the rest
         exist. `og:locale` alone claimed this page was the only version. */
      LOCALES.filter((code) => code !== locale).map((code) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Slocgtory - ${cardAlt}`} />
    <meta property="og:site_name" content="Slocgtory" />

    {/*
      The browser chrome on a phone. Set here as light and corrected by the
      script above before paint, because a saved theme is not a media query and
      `media=` on this tag cannot see it.
    */}
    <meta name="theme-color" content="#FBFBFC" data-theme-color />

    <link rel="icon" href="/icon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    {/*
      One file each, not eighteen. `preload` with no argument preloads every
      weight, style and subset a face has - measured, that was 18 <link
      rel=preload> on the home page, all of them competing for the same early
      bandwidth that the HTML and the stylesheet need. Preloading everything is
      preloading nothing.

      So: the body regular and the display weight the headings use, both Latin.
      Latin Extended still loads when a page needs it, just not ahead of the
      page itself, and the mono face is small and below the fold.
    */}
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font
      cssVariable="--font-display"
      preload={[{ weight: 600, style: 'normal', subset: 'latin' }]}
    />
    <Font cssVariable="--font-mono" />
  </head>

  <body>
    <a class="skip" href="#main">{site.skip}</a>

    <header class="site-head">
      <div class="inner">
        {/*
          Three zones: the name on the left, the tabs in the middle, settings on
          the right. The middle one is centred on the page rather than on what
          is left over, which is why the outer two are equal-width columns and
          not flex items - with `margin-right: auto` the strip drifts whenever
          the name or the language changes the width of either side.

          Home has a tab of its own even though the wordmark already goes there.
          A strip that starts at the second page reads as a logo with two links
          beside it; the duplicate destination is worth less than the strip
          being a complete list of where the site goes.
        */}
        <a class="wordmark" href={homeHref}>Slocgtory</a>

        <nav class="site-nav" aria-label={site.navLabel}>
          {
            tabs.map((tab) => (
              <a
                class="nav-link"
                href={tab.href}
                aria-current={!errorPage && page === tab.key ? 'page' : undefined}
              >
                {tab.label}
              </a>
            ))
          }
        </nav>

        {/*
          The offer hangs off the settings button rather than sitting under the
          masthead, because the button is what answers it. A notice in one place
          and its remedy in another makes the reader find the second on their
          own; anchored here, the sentence and the control that acts on it are
          the same object, and the panel behind it opens on the language list
          with System at the top.
        */}
        <Settings
          locale={locale}
          page={page}
          settingsLabel={site.settingsLabel}
          langLabel={site.langLabel}
          systemLanguage={site.systemLanguage}
          theme={site.theme}
        />

        <LanguageOffer locale={locale} page={page} />
      </div>
    </header>

    {/*
      No footer. It held a copyright line and the contact address, and the
      address is already where somebody looks for it - in Contact on the home
      page, and under Contact in the policy, which is the one Meta's submission
      form points at. A strip repeating it under every page was furniture.
    */}
    <main id="main">
      <slot />
    </main>

    {/*
      Printed pages only - see `@media print`. A saved copy of the policy is
      worth nothing if you cannot tell which page it came from or check it
      against the live one later.
    */}
    <p class="print-source">{canonical}</p>
  </body>
</html>
