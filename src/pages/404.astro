---
import Base from '../layouts/Base.astro';
import { loadLocale, inline, DEFAULT_LOCALE, LOCALES } from '../lib/i18n';

const data = await loadLocale(DEFAULT_LOCALE);

/*
  Sixteen of them, because GitHub Pages only has one 404.

  Every miss under every prefix is served this one file - `/pl/nonsense` gets
  exactly what `/nonsense` gets - so a page built in a single language told
  fifteen sixteenths of the site's readers, in a language they may not read,
  that something they cannot see went wrong. There is no server here to route
  around that, so all sixteen ship and the script picks one.

  Each translation already carries its own links: the Polish body points at
  `/pl/` and `/pl/privacy/`, so the way out lands on a page that is Polish the
  whole way down rather than back at English.
*/
const notFound = await Promise.all(
  LOCALES.map(async (code) => {
    const { site } = await loadLocale(code);
    return {
      code,
      title: site.notFoundTitle,
      body: site.notFoundBody,
      // The three tabs in this language too. Swapping the message and leaving
      // the navigation in English produced a page that was half translated -
      // and the half that stayed was the half offering the way out.
      nav: JSON.stringify([site.nav.home, site.nav.apps, site.nav.privacy]),
    };
  }),
);
---

<Base
  locale={DEFAULT_LOCALE}
  page="home"
  title={`${data.site.notFoundTitle} - Slocgtory`}
  description={data.site.notFoundTitle}
  site={data.site}
  errorPage
>
  {
    notFound.map(({ code, title, body, nav }) => (
      <section
        class="hero"
        lang={code}
        hidden={code !== DEFAULT_LOCALE}
        data-not-found={code}
        data-nav={nav}
      >
        <h1>{title}</h1>
        <p class="lede" set:html={inline(body)} />
      </section>
    ))
  }
</Base>

<script is:inline>
  (function () {
    var root = document.documentElement;

    // Worked out in the head before anything rendered, and shared with the
    // offer beside the settings button. See there for how it is matched.
    var match = root.getAttribute('data-browser-locale');
    if (!match) return;

    var wanted = document.querySelector('[data-not-found="' + match + '"]');
    var shown = document.querySelector('[data-not-found]:not([hidden])');
    if (!wanted || wanted === shown) return;

    if (shown) shown.hidden = true;
    wanted.hidden = false;

    // The page is now in that language, so say so - to a screen reader, which
    // reads the wrong voice off a stale `lang`, and in the tab, which is the
    // only part of this page a person sees before deciding it is not for them.
    root.lang = match;
    document.title = wanted.querySelector('h1').textContent + ' - Slocgtory';

    // The header came from the layout in the canonical language. Its labels and
    // its links both move, so the tabs go to this reader's version of each page
    // rather than back to English.
    var labels = JSON.parse(wanted.getAttribute('data-nav') || '[]');
    var prefix = match === 'en' ? '' : '/' + match;
    var leaves = ['/', '/apps/', '/privacy/'];
    var tabs = document.querySelectorAll('.nav-link');
    for (var i = 0; i < tabs.length && i < labels.length; i++) {
      tabs[i].textContent = labels[i];
      tabs[i].setAttribute('href', prefix + leaves[i]);
    }
  })();
</script>
