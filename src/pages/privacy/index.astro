---
import Base from '../../layouts/Base.astro';
import PrivacyBody from '../../components/PrivacyBody.astro';
import { loadLocale, DEFAULT_LOCALE } from '../../lib/i18n';

const data = await loadLocale(DEFAULT_LOCALE);
---

<Base
  locale={DEFAULT_LOCALE}
  page="privacy"
  title={`${data.privacy.metaTitle} - Slocgtory`}
  description={data.privacy.metaDescription}
  nav={data.site.nav}
  labels={{
      skip: data.site.skip,
      navLabel: data.site.navLabel,
      langLabel: data.site.langLabel,
      email: data.site.email,
    }}
>
  <PrivacyBody privacy={data.privacy} isCanonical={true} />
</Base>
